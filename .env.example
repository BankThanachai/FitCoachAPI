DATABASE_URL=postgresql://fitwork:fitwork_dev_password@db:5432/fitwork
PORT=3000

# ต้อง generate ค่าจริงเอง เช่น: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=changeme
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=changeme
JWT_REFRESH_EXPIRES_IN=30d

# Omise/Opn Payments — test-mode keys from https://dashboard.omise.co (Keys page, Test mode)
OMISE_SECRET_KEY=skey_test_changeme
OMISE_PUBLIC_KEY=pkey_test_changeme
# Optional — only if/when Omise's dashboard exposes a webhook signing secret for this account
OMISE_WEBHOOK_SECRET=

# Firebase Cloud Messaging — path to a service account JSON downloaded from
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Never commit the actual JSON file — keep it in secrets/ (gitignored).
FIREBASE_SERVICE_ACCOUNT_PATH=secrets/your-service-account.json

# Resend — email OTP verification (https://resend.com/api-keys)
RESEND_API_KEY=re_changeme
# Optional — defaults to onboarding@resend.dev until a domain is verified on Resend
RESEND_FROM_ADDRESS=

# Phone OTP delivery. "console" (default) just logs the OTP instead of
# sending a real SMS — use it for local dev/testing. No other provider is
# implemented yet.
SMS_PROVIDER=console
