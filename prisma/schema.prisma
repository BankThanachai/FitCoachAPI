// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  Male
  Female
}

enum UserType {
  Trainer
  Client
}

enum MuscleGroup {
  Legs
  Chest
  Back
  Core
}

enum ActivityStatus {
  Assigned
  Completed
  Skipped
}

model User {
  id                String         @id @default(uuid())
  email             String         @unique
  phone             String         @unique
  password          String
  name              String?
  age               Int?
  gender            Gender
  type              UserType
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  refreshTokens     RefreshToken[]
  reviewsWritten    Review[]       @relation("ReviewsWritten")
  reviewsReceived   Review[]       @relation("ReviewsReceived")
  exercisesAssigned Exercise[]     @relation("ExercisesAssigned")
  exercisesCreated  Exercise[]     @relation("ExercisesCreated")
  cardiosAssigned   Cardio[]       @relation("CardiosAssigned")
  cardiosCreated    Cardio[]       @relation("CardiosCreated")
  friendshipsAsA    Friendship[]   @relation("FriendshipsAsA")
  friendshipsAsB    Friendship[]   @relation("FriendshipsAsB")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Review {
  id           String   @id @default(uuid())
  score        Int
  comment      String?
  reviewerId   String
  reviewer     User     @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User     @relation("ReviewsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([targetUserId])
  @@index([reviewerId])
}

model Exercise {
  id           String         @id @default(uuid())
  name         String
  muscleGroup  MuscleGroup
  note         String?
  status       ActivityStatus @default(Assigned)
  assignedToId String
  assignedTo   User           @relation("ExercisesAssigned", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User           @relation("ExercisesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  sets         ExerciseSet[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([assignedToId])
  @@index([createdById])
}

model ExerciseSet {
  id         String   @id @default(uuid())
  order      Int
  weightKg   Decimal
  reps       Int
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, order])
}

model Cardio {
  id           String         @id @default(uuid())
  activity     String
  durationMin  Int
  kcal         Int
  avgHeartRate Int
  location     String
  distanceKm   Decimal?
  route        String?
  status       ActivityStatus @default(Assigned)
  assignedToId String
  assignedTo   User           @relation("CardiosAssigned", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User           @relation("CardiosCreated", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([assignedToId])
  @@index([createdById])
}

model Friendship {
  id        String   @id @default(uuid())
  userAId   String
  userA     User     @relation("FriendshipsAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("FriendshipsAsB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userAId, userBId])
  @@index([userBId])
}
