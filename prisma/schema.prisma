// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  Male
  Female
}

enum UserType {
  Trainer
  Client
}

enum ActivityStatus {
  Assigned
  Completed
  Skipped
}

enum DayOfWeek {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

enum WorkingHourStatus {
  Active
  Inactive
}

// PendingApproval -> TrainerApproved: trainer approves the client's
// booking (WorkoutsService.approveBooking). PendingApproval ->
// TrainerRejected: trainer declines it instead (rejectBooking), a dead
// end. TrainerApproved -> TrainerSubmitted: trainer finishes training
// and submits the session for the client to review (submitTraining).
// TrainerSubmitted -> Completed: client approves the submission
// (approveSubmission) — terminal. TrainerSubmitted -> ClientRejected:
// client disputes it instead (rejectSubmission) — not terminal: the
// trainer can revise the logged exercises and resubmit (submitTraining
// again, ClientRejected -> TrainerSubmitted), clearing the stored
// rejectReason. Cancelled is reachable from any non-terminal status by
// either party (cancelWorkout).
enum WorkoutStatus {
  PendingApproval
  TrainerApproved
  TrainerRejected
  TrainerSubmitted
  Completed
  ClientRejected
  Cancelled
}

// Users are never hard-deleted: DELETE /users/:id deactivates the account
// (UsersService.remove). Inactive users can't log in, aren't listed in trainer
// search and can't be bought courses from — everything else can still be viewed
// — and, unlike Active ones, they don't hold on to their email and phone: see
// the partial unique indexes on User below.
enum UserStatus {
  Active
  Inactive
}

enum ClientTrainerStatus {
  Pending
  Accepted
  Rejected
}

enum NotificationType {
  Workout
  ClientTrainerRequest
  ClientTrainerAccepted
  NewReview
  NewMessage
}

enum CouponType {
  Standard
  Trial
}

enum PaymentStatus {
  Pending
  Successful
  Failed
  Expired
  Reversed
  // Explicitly cancelled by the client before the QR's expires_at — distinct
  // from Expired (which means the window silently ran out) since Omise has
  // no server-side cancel for PromptPay charges; this is a local-only state.
  Cancelled
}

enum PaymentMethod {
  Card
  PromptPay
  TrueMoneyWallet
  InternetBanking
}

// OTHER covers any RevenueCat store we don't ship to ourselves — notably
// test_store (the dev/Test Store purchases the app currently uses) and
// promotional entitlements granted by hand from the RevenueCat dashboard.
enum SubscriptionStore {
  APP_STORE
  PLAY_STORE
  OTHER
}

// CANCELLED = auto-renew turned off, but Pro keeps working until
// Subscription.expiresAt. BILLING_RETRY = the store failed to charge the
// renewal and is retrying; Pro keeps working for as long as RevenueCat still
// reports the entitlement as active (i.e. the store's grace period).
enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  BILLING_RETRY
  EXPIRED
}

enum SubscriptionEnvironment {
  SANDBOX
  PRODUCTION
}

model User {
  id                      String                  @id @default(uuid())
  // email and phone are unique among ACTIVE users only, so a deactivated
  // account's contact details can be registered again. Prisma can't express
  // a partial unique index, so that is enforced by the User_email_active_key /
  // User_phone_active_key indexes created in the user_soft_delete migration
  // (not declared here), and there is deliberately no @unique on these two
  // fields: look users up with findFirst({ where: { email, status: Active } }),
  // never findUnique.
  email                   String
  phone                   String
  password                String
  firstName               String?
  lastName                String?
  birthDate               DateTime?
  weightKg                Decimal?                @db.Decimal(5, 2)
  heightCm                Decimal?                @db.Decimal(5, 2)
  medicalConditions       String?
  gender                  Gender
  province                String
  district                String
  subDistrict             String
  postalCode              String
  type                    UserType
  status                  UserStatus              @default(Active)
  deactivatedAt           DateTime?
  // Cached average of Review.score received as a trainer (rounded to 2
  // places) and the number of those reviews — both recomputed in the same
  // transaction as every new review (ReviewsService.create) so trainer
  // search can sort on them without aggregating at query time.
  rating                  Float                   @default(0)
  reviewCount             Int                     @default(0)
  // Public "Pro" badge / search-ranking flag. Kept in sync from RevenueCat
  // by SubscriptionsService.syncFromRevenueCat and the midnight expiry job,
  // so it can lag a lost webhook by up to a day — anything that actually
  // gates a feature must check Subscription.expiresAt instead.
  isPro                   Boolean                 @default(false)
  acceptsPartnerWork      Boolean                 @default(false)
  profilePhotoKey         String?
  emailVerifiedAt         DateTime?
  phoneVerifiedAt         DateTime?
  failedLoginAttempts     Int                     @default(0)
  lockedUntil             DateTime?
  emailOtpLockedUntil     DateTime?
  phoneOtpLockedUntil     DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  refreshTokens           RefreshToken[]
  emailOtps               EmailOtp[]
  phoneOtps               PhoneOtp[]
  reviewsWritten          Review[]                @relation("ReviewsWritten")
  reviewsReceived         Review[]                @relation("ReviewsReceived")
  exercisesAssigned       Exercise[]              @relation("ExercisesAssigned")
  exercisesCreated        Exercise[]              @relation("ExercisesCreated")
  cardiosAssigned         Cardio[]                @relation("CardiosAssigned")
  cardiosCreated          Cardio[]                @relation("CardiosCreated")
  clientTrainersAsClient  ClientTrainer[]         @relation("ClientTrainersAsClient")
  clientTrainersAsTrainer ClientTrainer[]         @relation("ClientTrainersAsTrainer")
  bankAccounts            BankAccount[]
  workingHours            WorkingHour[]
  workoutsAsClient        Workout[]               @relation("WorkoutsAsClient")
  workoutsAsTrainer       Workout[]               @relation("WorkoutsAsTrainer")
  trainerCourses          TrainerCourse[]
  conversationsAsClient   Conversation[]          @relation("ConversationsAsClient")
  conversationsAsTrainer  Conversation[]          @relation("ConversationsAsTrainer")
  messagesSent            Message[]               @relation("MessagesSent")
  deviceTokens            DeviceToken[]
  notifications           Notification[]
  coupons                 Coupon[]
  coursePurchases         CoursePurchase[]
  payments                Payment[]
  personalLogs            PersonalLog[]
  portfolioPhotos         TrainerPortfolioPhoto[]
  subscription            Subscription?
  subscriptionEvents      SubscriptionEvent[]

  @@index([type, isPro, rating, reviewCount])
}

model BankAccount {
  id            String   @id @default(uuid())
  bankName      String
  accountNumber String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([bankName, accountNumber])
  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailOtp {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PhoneOtp {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model Review {
  id           String         @id @default(uuid())
  score        Int
  comment      String?
  reviewerId   String
  reviewer     User           @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User           @relation("ReviewsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  purchaseId   String         @unique
  purchase     CoursePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  isAnonymous  Boolean        @default(false)
  reply        String?
  repliedAt    DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([targetUserId])
  @@index([reviewerId])
}

model Exercise {
  id           String         @id @default(uuid())
  name         String
  note         String?
  status       ActivityStatus @default(Assigned)
  assignedToId String
  assignedTo   User           @relation("ExercisesAssigned", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User           @relation("ExercisesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  workoutId    String
  workout      Workout        @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sets         ExerciseSet[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([assignedToId])
  @@index([createdById])
  @@index([workoutId])
}

model ExerciseSet {
  id         String   @id @default(uuid())
  order      Int
  weightKg   Decimal?
  reps       Int
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, order])
}

model PersonalLog {
  id        String                @id @default(uuid())
  clientId  String
  client    User                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  date      DateTime              @db.Date
  note      String?
  exercises PersonalLogExercise[]
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([clientId])
}

model PersonalLogExercise {
  id            String                   @id @default(uuid())
  name          String
  personalLogId String
  personalLog   PersonalLog              @relation(fields: [personalLogId], references: [id], onDelete: Cascade)
  sets          PersonalLogExerciseSet[]
  createdAt     DateTime                 @default(now())

  @@index([personalLogId])
}

model PersonalLogExerciseSet {
  id                    String              @id @default(uuid())
  order                 Int
  weightKg              Decimal?
  reps                  Int
  personalLogExerciseId String
  personalLogExercise   PersonalLogExercise @relation(fields: [personalLogExerciseId], references: [id], onDelete: Cascade)

  @@unique([personalLogExerciseId, order])
}

model TrainerPortfolioPhoto {
  id        String   @id @default(uuid())
  trainerId String
  trainer   User     @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  key       String
  order     Int
  createdAt DateTime @default(now())

  @@unique([trainerId, order])
  @@index([trainerId])
}

model Cardio {
  id           String         @id @default(uuid())
  activity     String
  durationMin  Int
  kcal         Int
  avgHeartRate Int
  location     String
  distanceKm   Decimal?
  route        String?
  status       ActivityStatus @default(Assigned)
  assignedToId String
  assignedTo   User           @relation("CardiosAssigned", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User           @relation("CardiosCreated", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([assignedToId])
  @@index([createdById])
}

model ClientTrainer {
  id        String              @id @default(uuid())
  clientId  String
  client    User                @relation("ClientTrainersAsClient", fields: [clientId], references: [id], onDelete: Cascade)
  trainerId String
  trainer   User                @relation("ClientTrainersAsTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  status    ClientTrainerStatus @default(Pending)
  createdAt DateTime            @default(now())

  @@index([clientId, trainerId])
  @@index([trainerId])
}

model WorkingHour {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startTime DateTime          @db.Time
  endTime   DateTime          @db.Time
  status    WorkingHourStatus @default(Active)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, dayOfWeek])
}

model Workout {
  id           String         @id @default(uuid())
  trainerId    String
  trainer      User           @relation("WorkoutsAsTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  clientId     String
  client       User           @relation("WorkoutsAsClient", fields: [clientId], references: [id], onDelete: Cascade)
  purchaseId   String
  purchase     CoursePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  date         DateTime       @db.Date
  fromTime     DateTime       @db.Time
  toTime       DateTime       @db.Time
  status       WorkoutStatus  @default(PendingApproval)
  rejectReason String?
  exercises    Exercise[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([trainerId])
  @@index([clientId])
  @@index([purchaseId])
}

model TrainerCourse {
  id        String           @id @default(uuid())
  trainerId String
  trainer   User             @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  sessions  Int
  price     Decimal
  isTrial   Boolean          @default(false)
  purchases CoursePurchase[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([trainerId])
}

model CoursePurchase {
  id          String           @id @default(uuid())
  clientId    String
  client      User             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  courseId    String
  course      TrainerCourse    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  purchasedAt DateTime         @default(now())
  workouts    Workout[]
  coupons     PurchaseCoupon[]
  payment     Payment?
  review      Review?

  @@index([clientId])
  @@index([courseId])
}

model Coupon {
  id             String          @id @default(uuid())
  title          String
  description    String
  couponType     CouponType      @default(Standard)
  clientId       String
  client         User            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  minSessions    Int?
  bonusSessions  Int             @default(1)
  expiresAt      DateTime
  usedAt         DateTime?
  usedTrainerId  String?
  purchaseCoupon PurchaseCoupon?
  createdAt      DateTime        @default(now())

  @@index([clientId])
}

model PurchaseCoupon {
  id         String         @id @default(uuid())
  purchaseId String
  purchase   CoursePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  couponId   String         @unique
  coupon     Coupon         @relation(fields: [couponId], references: [id])
  createdAt  DateTime       @default(now())

  @@index([purchaseId])
}

model Conversation {
  id        String    @id @default(uuid())
  clientId  String
  client    User      @relation("ConversationsAsClient", fields: [clientId], references: [id], onDelete: Cascade)
  trainerId String
  trainer   User      @relation("ConversationsAsTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())

  @@unique([clientId, trainerId])
  @@index([trainerId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model DeviceToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Payment {
  id             String          @id @default(uuid())
  clientId       String
  client         User            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  purchaseId     String?         @unique
  purchase       CoursePurchase? @relation(fields: [purchaseId], references: [id])
  opnChargeId    String?         @unique
  opnSourceId    String?
  method         PaymentMethod
  status         PaymentStatus   @default(Pending)
  amount         Decimal
  currency       String          @default("THB")
  paidAt         DateTime?
  failureCode    String?
  failureMessage String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  events         PaymentEvent[]
  refunds        PaymentRefund[]

  @@index([clientId])
  @@index([status])
}

model PaymentEvent {
  id         String   @id @default(uuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  opnEventId String   @unique
  eventType  String
  rawPayload Json
  receivedAt DateTime @default(now())

  @@index([paymentId])
}

model PaymentRefund {
  id          String   @id @default(uuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  opnRefundId String   @unique
  amount      Decimal
  reason      String?
  createdAt   DateTime @default(now())

  @@index([paymentId])
}

// A trainer's FitWork Pro membership, mirrored from RevenueCat — one row per
// user, keyed on our own User.id (not the Apple/Google account) so Pro
// follows the user across devices. Kept apart from User on purpose: UsersService
// spreads every User column into public profile responses, and the store,
// status and expiry date must not leak into other people's view of a profile.
model Subscription {
  id                    String                  @id @default(uuid())
  userId                String                  @unique
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  store                 SubscriptionStore
  productId             String
  status                SubscriptionStatus
  startedAt             DateTime
  expiresAt             DateTime
  originalTransactionId String?
  environment           SubscriptionEnvironment
  lastSyncedAt          DateTime
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([expiresAt])
}

// One row per RevenueCat webhook delivery that matched a user — eventId is
// RevenueCat's own event id (reused across its retries), so it doubles as the
// dedupe key, like PaymentEvent.opnEventId.
model SubscriptionEvent {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId    String   @unique
  eventType  String
  rawPayload Json
  receivedAt DateTime @default(now())

  @@index([userId])
}
