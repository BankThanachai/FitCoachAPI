// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  Male
  Female
}

enum UserType {
  Trainer
  Client
}

enum MuscleGroup {
  Legs
  Chest
  Back
  Core
}

enum ActivityStatus {
  Assigned
  Completed
  Skipped
}

enum DayOfWeek {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

enum WorkingHourStatus {
  Active
  Inactive
}

enum WorkoutStatus {
  Pending
  Confirmed
  PendingApproval
  Completed
  Cancelled
}

enum ClientTrainerStatus {
  Pending
  Accepted
  Rejected
}

enum NotificationType {
  WorkoutBooked
  WorkoutConfirmed
  WorkoutCancelled
  WorkoutPendingApproval
  ClientTrainerRequest
  ClientTrainerAccepted
  NewReview
  NewMessage
}

enum CouponType {
  Standard
  Trial
}

enum PaymentStatus {
  Pending
  Successful
  Failed
  Expired
  Reversed
}

enum PaymentMethod {
  Card
  PromptPay
  TrueMoneyWallet
  InternetBanking
}

model User {
  id                      String           @id @default(uuid())
  email                   String           @unique
  phone                   String           @unique
  password                String
  name                    String?
  age                     Int?
  gender                  Gender
  province                String
  district                String
  subDistrict             String
  postalCode              String
  type                    UserType
  rating                  Float            @default(0)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  refreshTokens           RefreshToken[]
  reviewsWritten          Review[]         @relation("ReviewsWritten")
  reviewsReceived         Review[]         @relation("ReviewsReceived")
  exercisesAssigned       Exercise[]       @relation("ExercisesAssigned")
  exercisesCreated        Exercise[]       @relation("ExercisesCreated")
  cardiosAssigned         Cardio[]         @relation("CardiosAssigned")
  cardiosCreated          Cardio[]         @relation("CardiosCreated")
  clientTrainersAsClient  ClientTrainer[]  @relation("ClientTrainersAsClient")
  clientTrainersAsTrainer ClientTrainer[]  @relation("ClientTrainersAsTrainer")
  bankAccounts            BankAccount[]
  workingHours            WorkingHour[]
  workoutsAsClient        Workout[]        @relation("WorkoutsAsClient")
  workoutsAsTrainer       Workout[]        @relation("WorkoutsAsTrainer")
  trainerCourses          TrainerCourse[]
  conversationsAsClient   Conversation[]   @relation("ConversationsAsClient")
  conversationsAsTrainer  Conversation[]   @relation("ConversationsAsTrainer")
  messagesSent            Message[]        @relation("MessagesSent")
  deviceTokens            DeviceToken[]
  notifications           Notification[]
  coupons                 Coupon[]
  coursePurchases         CoursePurchase[]
  payments                Payment[]
}

model BankAccount {
  id            String   @id @default(uuid())
  bankName      String
  accountNumber String
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Review {
  id           String   @id @default(uuid())
  score        Int
  comment      String?
  reviewerId   String
  reviewer     User     @relation("ReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  targetUserId String
  targetUser   User     @relation("ReviewsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([targetUserId])
  @@index([reviewerId])
}

model Exercise {
  id           String         @id @default(uuid())
  name         String
  muscleGroup  MuscleGroup
  note         String?
  status       ActivityStatus @default(Assigned)
  assignedToId String
  assignedTo   User           @relation("ExercisesAssigned", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User           @relation("ExercisesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  workoutId    String
  workout      Workout        @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  sets         ExerciseSet[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([assignedToId])
  @@index([createdById])
  @@index([workoutId])
}

model ExerciseSet {
  id         String   @id @default(uuid())
  order      Int
  weightKg   Decimal
  reps       Int
  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@unique([exerciseId, order])
}

model Cardio {
  id           String         @id @default(uuid())
  activity     String
  durationMin  Int
  kcal         Int
  avgHeartRate Int
  location     String
  distanceKm   Decimal?
  route        String?
  status       ActivityStatus @default(Assigned)
  assignedToId String
  assignedTo   User           @relation("CardiosAssigned", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById  String
  createdBy    User           @relation("CardiosCreated", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([assignedToId])
  @@index([createdById])
}

model ClientTrainer {
  id        String              @id @default(uuid())
  clientId  String
  client    User                @relation("ClientTrainersAsClient", fields: [clientId], references: [id], onDelete: Cascade)
  trainerId String
  trainer   User                @relation("ClientTrainersAsTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  status    ClientTrainerStatus @default(Pending)
  createdAt DateTime            @default(now())

  @@index([clientId, trainerId])
  @@index([trainerId])
}

model WorkingHour {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek DayOfWeek
  startTime DateTime          @db.Time
  endTime   DateTime          @db.Time
  status    WorkingHourStatus @default(Active)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@unique([userId, dayOfWeek])
}

model Workout {
  id         String         @id @default(uuid())
  trainerId  String
  trainer    User           @relation("WorkoutsAsTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  clientId   String
  client     User           @relation("WorkoutsAsClient", fields: [clientId], references: [id], onDelete: Cascade)
  purchaseId String
  purchase   CoursePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  date       DateTime       @db.Date
  fromTime   DateTime       @db.Time
  toTime     DateTime       @db.Time
  status     WorkoutStatus  @default(Pending)
  exercises  Exercise[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([trainerId])
  @@index([clientId])
  @@index([purchaseId])
}

model TrainerCourse {
  id        String           @id @default(uuid())
  trainerId String
  trainer   User             @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  sessions  Int
  price     Decimal
  isTrial   Boolean          @default(false)
  purchases CoursePurchase[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([trainerId])
}

model CoursePurchase {
  id          String           @id @default(uuid())
  clientId    String
  client      User             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  courseId    String
  course      TrainerCourse    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  purchasedAt DateTime         @default(now())
  workouts    Workout[]
  coupons     PurchaseCoupon[]
  payment     Payment?

  @@index([clientId])
  @@index([courseId])
}

model Coupon {
  id             String          @id @default(uuid())
  title          String
  description    String
  couponType     CouponType      @default(Standard)
  clientId       String
  client         User            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  minSessions    Int?
  expiresAt      DateTime
  usedAt         DateTime?
  usedTrainerId  String?
  purchaseCoupon PurchaseCoupon?
  createdAt      DateTime        @default(now())

  @@index([clientId])
}

model PurchaseCoupon {
  id         String         @id @default(uuid())
  purchaseId String
  purchase   CoursePurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  couponId   String         @unique
  coupon     Coupon         @relation(fields: [couponId], references: [id])
  createdAt  DateTime       @default(now())

  @@index([purchaseId])
}

model Conversation {
  id        String    @id @default(uuid())
  clientId  String
  client    User      @relation("ConversationsAsClient", fields: [clientId], references: [id], onDelete: Cascade)
  trainerId String
  trainer   User      @relation("ConversationsAsTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())

  @@unique([clientId, trainerId])
  @@index([trainerId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model DeviceToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Notification {
  id         String           @id @default(uuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType
  title      String
  body       String
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Payment {
  id             String          @id @default(uuid())
  clientId       String
  client         User            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  purchaseId     String?         @unique
  purchase       CoursePurchase? @relation(fields: [purchaseId], references: [id])
  opnChargeId    String?         @unique
  opnSourceId    String?
  method         PaymentMethod
  status         PaymentStatus   @default(Pending)
  amount         Decimal
  currency       String          @default("THB")
  paidAt         DateTime?
  failureCode    String?
  failureMessage String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  events         PaymentEvent[]
  refunds        PaymentRefund[]

  @@index([clientId])
  @@index([status])
}

model PaymentEvent {
  id         String   @id @default(uuid())
  paymentId  String
  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  opnEventId String   @unique
  eventType  String
  rawPayload Json
  receivedAt DateTime @default(now())

  @@index([paymentId])
}

model PaymentRefund {
  id          String   @id @default(uuid())
  paymentId   String
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  opnRefundId String   @unique
  amount      Decimal
  reason      String?
  createdAt   DateTime @default(now())

  @@index([paymentId])
}
